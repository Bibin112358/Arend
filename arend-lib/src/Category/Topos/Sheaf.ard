\import Paths
\import Paths.Meta
\import Topology.Locale
\open PresieveMatchingFamily (matchingFamily)

\record MatchingFamily.{s,o1,h1,o2,h2} {C : Site.{o1,h1}} {D : Precat.{o2,h2}} (F : Functor C.op D) {J : \Type s} (x : C) (P : J -> ObOver x) (d : D)
  | \coerce family (j : J) : Hom d (F (P j).1)
  | isMatching {j j' : J} {z : C} (g : Hom z (P j).1) (g' : Hom z (P j').1) : (P j).2 ∘ g = (P j').2 ∘ g' -> F.Func g ∘ family j = F.Func g' ∘ family j'
  \where {
    \func matchingFamily.{s,o1,h1,o2,h2} {C : Site.{o1,h1}} {D : Precat.{o2,h2}} (F : Functor C.op D) {J : \Type s} (x : C) (P : J -> ObOver x) (d : D) (h : Hom d (F x)) : MatchingFamily F x P d \cowith
      | family j => Func (P j).2 ∘ h
      | isMatching g g' gg' => inv o-assoc *> pmap (`∘ h) (inv Func-o *> pmap Func (later gg') *> Func-o) *> o-assoc

    \protected \func map.{s,o1,h1,o2,h2} {C : Site.{o1,h1}} {D : Precat.{o2,h2}} (F : Functor C.op D) {I J : \Type s} (f : I -> J) {x : C} (P : J -> ObOver x) (d : D) (mf : MatchingFamily F x P d) : MatchingFamily F x (\lam i => P (f i)) d \cowith
      | family i => mf (f i)
      | isMatching => isMatching
      \where {
        \lemma isEquiv (fs : IsSurj f) : IsEquiv (map F f P d)
          => IsEquiv.fromInjSurj (\lam p => exts \lam j => \case \elim j, fs j \with {
            | _, inP (i,idp) => path (p __ i)
          }) \lam mf =>
            \let t j => TruncP.rec-set {_} {Hom d (F (P j).1) } (fs j) (\lam s => Func (C.idtoiso $ pmap (\lam x => (P x).1) $ inv s.2).f ∘ mf s.1)
              \lam s s' => mf.isMatching _ _ $ inv (ObOver.unequals (pmap P (inv s.2))) *> ObOver.unequals (pmap P (inv s'.2))
            \in inP (\new MatchingFamily {
              | family j => (t j).1
              | isMatching {j} {j'} g g' gg' => \case (t j).2, (t j').2 \with {
                | inP (s,sp), inP (s',s'p) =>
                  \have aux => mf.isMatching ((C.idtoiso $ pmap (\lam x => (P x).1) (inv s.2)).f ∘ g) ((C.idtoiso $ pmap (\lam x => (P x).1) (inv s'.2)).f ∘ g') $ inv o-assoc *> pmap (`∘ _) (inv $ ObOver.unequals (pmap P (inv s.2))) *> gg' *> pmap (`∘ _) (ObOver.unequals (pmap P (inv s'.2))) *> o-assoc
                  \in pmap (_ ∘) (inv sp) *> inv o-assoc *> pmap (`∘ _) (inv Func-o) *> aux *> pmap (`∘ _) Func-o *> o-assoc *> pmap (_ ∘) s'p
              }
            }, exts \lam i => TruncP.rec-set-eval (later (i,idp)) *> pmap (`∘ _) (later Func-id) *> id-left)
      }
  }

\func PresieveMatchingFamily.{o1,h1,o2,h2} {C : Site.{o1,h1}} {D : Precat.{o2,h2}} (F : Functor C.op D) (x : C) (P : Presieve x) (d : D)
  => MatchingFamily F {Given P} x __.1 d
  \where {
    \func matchingFamily.{o1,h1,o2,h2} {C : Site.{o1,h1}} {D : Precat.{o2,h2}} (F : Functor C.op D) (x : C) (P : Presieve x) (d : D) (h : Hom d (F x)) : PresieveMatchingFamily F x P d
      => MatchingFamily.matchingFamily F {Given P} x __.1 d h
  }

\func IsSeparatedPresheaf.{o2,h2,o1,h1} {C : Site.{o1,h1}} {D : Precat.{o2,h2}} (F : Functor C.op D)
  => ∀ {x : C} ∀ {S : isCover x} (d : F.D) {h h' : Hom d (F x)} (∀ {y : S} (F.Func y.2 ∘ h = F.Func y.2 ∘ h') -> h = h')
  \where {
    \protected \lemma char : IsSeparatedPresheaf F <-> ∀ {x : C} ∀ {S : isCover x} (d : F.D) (IsInj {_} {PresieveMatchingFamily F x S d} (matchingFamily F x S d))
      => (\lam Fs {x} {S} Sc d hh' => Fs Sc d \lam {y} Sy => pmap {PresieveMatchingFamily F x S d} (family {__} (y,Sy)) hh',
          \lam Fs Sc d hh' => Fs Sc d $ exts \lam j => hh' j.2)
  }

\func IsSheaf.{o2,h2,o1,h1} {C : Site.{o1,h1}} {D : Precat.{o2,h2}} (F : Functor C.op D)
  => ∀ {x : C} ∀ {S : isCover x} (d : F.D) (IsEquiv {_} {PresieveMatchingFamily F x S d} (matchingFamily F x S d))

-- | Sheaves valued in {D}
\class VSheaf.{s,o,h} \extends VPresheaf.{o,h,s,s} {
  \override C : Site.{s,s}
  | isSheaf : IsSheaf F

  \lemma isSeparated : IsSeparatedPresheaf \this.F
    => IsSeparatedPresheaf.char.2 \lam Sc d => IsEquiv.isInj (isSheaf Sc d)

  \lemma direct_image.{s',o',h'} {C' : Site.{s',s'}} (f : SiteHom C' C) : VSheaf D C' (Comp F f.op) \cowith
    | isSheaf {x} {S} xS d => IsEquiv.trans (isSheaf (f.Func-cover xS) d) $
        IsEquiv.trans (MatchingFamily.map.isEquiv {C} {D} {F} {Given S} {Given (py : ObOver (f x)) ∃ (px : S) (py = (f px.1, Func px.2))} {\lam s => (_, inP (s.1,s.2,idp))} \lam (_, inP (px,Spx,idp)) => inP ((px,Spx),idp)) $
        inP \new QEquiv {
          | f mf => \new MatchingFamily {
            | family => mf.family
            | isMatching {j} {j'} g g' gg' => mf.isMatching (Func g) (Func g') $ inv Func-o *> pmap Func gg' *> Func-o
          }
          | ret mf => \new MatchingFamily {
            | family => mf.family
            | isMatching {j} {j'} g g' gg' => \case f.Func-flat j.1.2 j'.1.2 g g' gg' \with {
              | inP (w,s1,s2,s1s2,h,s1h,s2h) => rewrite (inv s1h, inv s2h, F.Func-o, F.Func-o) $ o-assoc *> pmap (_ ∘) (mf.isMatching s1 s2 s1s2) *> inv o-assoc
            }
          }
          | ret_f => idpe
          | f_sec => idpe
        }
} \where {
  \func restrict.{s,o,h} {L : Locale.{s}} (a : L) (S : VSheaf.{s,o,h} { | C => L }) : VSheaf S.D (L.restrict a) \cowith
    | F => Comp S Locale.restrict.functor.op
    | isSheaf => {?} -- TODO[sorts]

  \lemma direct_image_locale.{s,o,h,o',h'} {L L' : Locale.{s}} (f : FrameHom L' L) (S : VSheaf.{s,o,h} { | C => L }) : VSheaf S.D L' (Comp S f.functor.op)
    => S.direct_image f.functor

  \func direct_image_id.{s,o,h} {C : Site.{s,s}} (S : VSheaf.{s,o,h} { | C => C }) : S.direct_image SiteHom.id = {VSheaf S.D C} S
    => ext $ ext (idp, ext \lam h => idp)

  \func transport_direct_image.{s,o,h} {L L' : Locale.{s}} (p : L = L') (S : VSheaf.{s,o,h} { | C => L }) : transport (VSheaf S.D) p S = direct_image_locale (Iso.f {Precat.idtoiso p}) S \elim p
    | idp => inv (direct_image_id S)

  \func transport_direct_image-iso.{s,o,h} {L L' : Locale.{s}} (e : Iso {LocaleCat} {L} {L'}) (S : VSheaf.{s,o,h} { | C => L }) : transport (VSheaf S.D) (Cat.isotoid e) S = direct_image_locale e.f S
    => transport_direct_image (Cat.isotoid e) S *> path \lam i => direct_image_locale (IsEquiv.f_ret univalence {e} i).f S
}

\instance VSheafCat.{s,v} (D : Cat.{\suc v, v}) (C : Site.{s,s}) : Cat
  => subCat {VPresheafCat D C} {VSheaf D C} (\new Embedding {
    | f P => P
    | isEmb _ _ => \new Retraction {
      | sec p => ext VSheaf { | VPresheaf => p }
      | f_sec => idpe
    }
  })

-- | Sheaves valued in sets
\class Sheaf.{s,v} \extends Presheaf.{v,s,s}, VSheaf.{s, \suc v, v}

\lemma sheafOnPresentedFrame.{s,o,h} {P : FramePres.{s}} {D : CompleteCat.{s,o,h}} (F : VSheaf D (FramePresSite P)) : VSheaf D (PresentedFrame P) extend \cowith
  | isSheaf => {?}
  {-
